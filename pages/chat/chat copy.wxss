/* ========== 输入按键区部分 - 干净版本 ========== */
.ask-input-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.95);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
  z-index: 100;
  gap: 20rpx;
  box-sizing: border-box;
}

/* 语音/键盘切换按钮 */
.text-video-img {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 60rpx;
}

/* 文本输入框 */
.input-big {
  flex: 1;
  min-height: 70rpx;
  max-height: 150rpx;
  background: #f5f5f5;
  border-radius: 35rpx;
  padding: 15rpx 25rpx;
  border: 1rpx solid #ddd;
  font-size: 28rpx;
  line-height: 1.5;
  overflow-y: auto;
}

/* 发送按钮图片 */
.send-img {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

/* 语音输入按钮 */
.voice-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: normal;
  background-color: #07c160 !important;
  color: #fff !important;
  border-radius: 40rpx;
  margin: 0;
  padding: 0;
}

.voice-btn::after {
  border: none;
}

/* 语音按钮禁用状态 */
.voice-btn[disabled] {
  background-color: #ccc !important;
  color: #666 !important;
}


/* 在文件末尾添加以下样式（不要删除原有的任何样式） */

/* 熊猫图片后备容器 */
.ai-img-wrapper {
  position: relative;
  width: 60vw;
  margin-top: 10%;
}

.ai-img {
  width: 100%;
  object-fit: contain;
}

.ai-img-fallback {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 120rpx;
}

