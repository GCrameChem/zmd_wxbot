  margin-left: 10rpx;
}

.tri-top2 {
  position: absolute;
  border-top: 30rpx solid #e6edfd;
  border-left: 20rpx solid transparent;
  top: -12rpx;
  left: -4rpx;
  margin-top: 4rpx;  /* 增加此值，向下移动气泡尖 */
}

